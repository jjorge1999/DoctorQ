{
  "name": "doctorq",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-doctorq",
    "seed": "node tools/seed.mjs",
    "dev": "ng serve --open",
    "deploy": "npm run deploy:backend && npm run deploy:frontend",
    "deploy:backend": "firebase deploy --only firestore",
    "deploy:frontend": "npm run build && wrangler pages deploy dist/doctorq/browser --project-name=doctorq"
  },
  "private": true,
  "packageManager": "npm@8.19.4",
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "firebase": "^12.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "firebase-tools": "^14.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.60.0"
  }
}
